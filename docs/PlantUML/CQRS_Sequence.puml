@startuml CQRS_Sequence
autonumber
skinparam style strictuml
skinparam sequenceMessageAlign center

actor "Client / SPA" as Client
participant "Host API\n(Minimal API)" as Host
participant "IModule\nInterface" as Module
participant "MediatR Pipeline\n(Validation/Logging)" as Pipeline
participant "Command Handler" as Handler
participant "Thesis\n(Aggregate Root)" as Domain
participant "IThesisRepository" as Repo
database "SQL Server\n(Module Schema)" as DB

== Luồng Ghi (Command Processing Flow) ==
Client -> Host: POST /api/theses/{id}/submit-outline
Host -> Module: ExecuteCommandAsync(SubmitOutlineCommand)
Module -> Pipeline: Send(command)
Pipeline -> Pipeline: Validate(command)
Pipeline -> Handler: Handle(SubmitOutlineCommand)
Handler -> Repo: GetByIdAsync(id)
Repo -> DB: SELECT ... FROM thesis_management.Theses
DB --> Repo: Raw data
Repo --> Handler: Thesis (Aggregate Root)

Handler -> Domain: SubmitOutline(fileUrl, fileName, fileSize)
Domain -> Domain: ValidateBusinessRules()
Domain -> Domain: AddDomainEvent(OutlineSubmittedDomainEvent)

Handler -> Repo: UnitOfWork.CommitAsync()
Repo -> DB: BEGIN TRANSACTION\nUPDATE Theses\nINSERT OutboxMessages\nCOMMIT
DB --> Repo: Success
Repo --> Handler: Ok
Handler --> Module: Result.Success()
Module --> Host: 200 OK
Host --> Client: 200 OK (JSON Result)

== Luồng Đọc (Query Processing Flow) ==
Client -> Host: GET /api/theses/{id}
Host -> Module: ExecuteQueryAsync(GetThesisDetailsQuery)
Module -> Handler: Handle(GetThesisDetailsQuery)
Handler -> DB: SELECT ... (Direct Projection)
DB --> Handler: DTO Data
Handler --> Host: ThesisDetailsDto
Host --> Client: 200 OK (JSON DTO)

@enduml
