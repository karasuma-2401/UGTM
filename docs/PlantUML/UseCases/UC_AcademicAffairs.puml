@startuml UC_AcademicAffairs
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60

skinparam actor {
    BackgroundColor #FCE4EC
    BorderColor #880E4F
    FontName Arial
    FontSize 13
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #AD1457
    ArrowColor #880E4F
    FontName Arial
    FontSize 12
}

title Sơ đồ Use Case Phân hệ Phòng Đào Tạo (Academic Affairs Subsystem)\n(Tham chiếu Bảng 2.6 Báo cáo Phân tích Yêu cầu)

actor "Chuyên viên Phòng Đào Tạo\n(Academic Affairs Staff)" as AAStaff

rectangle "Phân hệ Phòng Đào Tạo - UGTM" {
    usecase "UC-AA01: Phê duyệt Đơn xin ĐTĐT\n(Bước 3 cuối cùng trong luồng liên thông 3 bên)" as UC01
    usecase "Tự động cập nhật Tên Đề tài mới\n& mở quyền nộp Đề cương mới" as UC_AutoUpdate #FCE4EC

    usecase "UC-AA02: Ban hành QĐ thành lập Hội đồng\n(Tiếp nhận dự thảo từ Khoa & upload QĐ online)" as UC02
    
    usecase "UC-AA03: Trích xuất Báo cáo & Công nhận tốt nghiệp\n(Báo cáo kết quả KLTN toàn trường theo mẫu chuẩn)" as UC03
    usecase "Tra cứu Danh sách Sinh viên & Kết quả KLTN" as UC_Lookup
}

' Liên kết từ Phòng Đào Tạo
AAStaff --> UC01
AAStaff --> UC02
AAStaff --> UC03
AAStaff --> UC_Lookup

' Quan hệ Include
UC01 .right.> UC_AutoUpdate : <<include>>

@enduml
