@startuml UC_Faculty
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 60

skinparam actor {
    BackgroundColor #FFF3E0
    BorderColor #E65100
    FontName Arial
    FontSize 13
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #EF6C00
    ArrowColor #E65100
    FontName Arial
    FontSize 12
}

title Sơ đồ Use Case Phân hệ Văn phòng Khoa (Faculty Subsystem)\n(Tham chiếu Bảng 2.5 Báo cáo Phân tích Yêu cầu)

actor "Giáo vụ Khoa\n(Faculty Staff)" as Staff
actor "Lãnh đạo Khoa\n(Dean / Vice Dean)" as Dean

Staff <|-- Dean

rectangle "Phân hệ Văn phòng Khoa - UGTM" {
    package "Giai đoạn Đề tài & Đề cương (Tuần 0 - 2)" {
        usecase "UC-FAC01: Thẩm định & Duyệt đề tài\n(Đạt / Yêu cầu sửa / Từ chối)" as UC01
        usecase "UC-FAC02: Công bố danh mục đề tài\n(Mở quyền tra cứu và đăng ký)" as UC02
        usecase "UC-FAC03: Thẩm định Đề cương chi tiết\n(Cổng kiểm soát 1 - Tuần 2)" as UC03
    }

    package "Giai đoạn Giữa kỳ & Đổi tên đề tài (Tuần 3 - 10)" {
        usecase "UC-FAC04: Phê duyệt Đơn xin ĐTĐT\n(Bước 2: Ký duyệt chuyển PĐT)" as UC04
        usecase "UC-FAC05: Xử lý & Tiếp nhận KQ Báo cáo giữa kỳ\n(Tổng hợp danh sách Tiếp tục / Dừng KLTN)" as UC05
    }

    package "Giai đoạn Phản biện & Hội đồng (Tuần 11 - 20)" {
        usecase "UC-FAC06: Phân công Giảng viên phản biện\n(Gán GVPB cho đề tài đủ điều kiện)" as UC06
        usecase "UC-FAC07: Lập dự thảo Hội đồng & Xếp lịch\n(Xếp phòng, ca, phân công thành viên HĐ)" as UC07
        usecase "UC-FAC08: Xác nhận Hoàn thành Lưu chiểu\n(Điều kiện tiên quyết để trả điểm chính thức)" as UC08
        usecase "UC-FAC09: Cấp quyền Mở khóa điểm Hội đồng\n(Xử lý khiếu nại điểm hợp lệ)" as UC09 #FFEBEE
    }

    package "Giai đoạn Tổng kết & Công bố (Tuần 21)" {
        usecase "UC-FAC10: Tổng hợp điểm 3 nguồn\n(Áp dụng công thức trọng số Strategy)" as UC10
        usecase "UC-FAC11: Công bố kết quả & Xuất báo cáo\n(Xuất file Excel / PDF)" as UC11
    }
}

' Liên kết từ Giáo vụ Khoa
Staff --> UC01
Staff --> UC02
Staff --> UC03
Staff --> UC04
Staff --> UC05
Staff --> UC06
Staff --> UC07
Staff --> UC08
Staff --> UC10
Staff --> UC11

' Liên kết từ Lãnh đạo Khoa
Dean --> UC09

@enduml
