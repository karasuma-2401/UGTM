@startuml UC_Admin
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60

skinparam actor {
    BackgroundColor #F3E5F5
    BorderColor #4A148C
    FontName Arial
    FontSize 13
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #6A1B9A
    ArrowColor #4A148C
    FontName Arial
    FontSize 12
}

title Sơ đồ Use Case Phân hệ Quản trị viên hệ thống (Admin Subsystem)\n(Tham chiếu Bảng 2.7 & Mục 2.1.1 Báo cáo Phân tích Yêu cầu)

actor "Quản trị viên\n(System Admin)" as Admin

rectangle "Phân hệ Quản trị viên hệ thống - UGTM" {
    usecase "UC-SYS01: Quản trị Người dùng & Phân quyền (RBAC)\n(Tạo mới, cập nhật, khóa tài khoản, phân quyền 7 nhóm vai trò)" as UC01
    usecase "Import Danh sách SV & Giảng viên từ Excel" as UC_ImportExcel #F3E5F5

    usecase "UC-SYS02: Cấu hình Đợt KLTN & Mốc thời gian\n(Thiết lập đợt 21 tuần, cấu hình deadline nộp/duyệt 7 giai đoạn)" as UC02
    
    usecase "UC-SYS03: Cấu hình Tham số & Trọng số tính điểm\n(Tùy chỉnh tỷ lệ % trọng số GVHD, GVPB, Hội đồng theo kỳ)" as UC03
    
    usecase "UC-SYS04: Theo dõi Nhật ký hệ thống (Audit Log)\n(Lọc theo người dùng, thao tác, khoảng thời gian)" as UC04
    usecase "Ghi vết mọi thao tác cấu hình & phân quyền" as UC_AuditTrace #F3E5F5
}

' Liên kết từ Quản trị viên
Admin --> UC01
Admin --> UC02
Admin --> UC03
Admin --> UC04

' Quan hệ Include & Extend
UC01 .right.> UC_AuditTrace : <<include>>
UC03 .right.> UC_AuditTrace : <<include>>
UC_ImportExcel .left.> UC01 : <<extend>>

@enduml
