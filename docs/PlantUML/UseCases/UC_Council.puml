@startuml UC_Council
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60

skinparam actor {
    BackgroundColor #EDE7F6
    BorderColor #512DA8
    FontName Arial
    FontSize 13
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #5E35B1
    ArrowColor #512DA8
    FontName Arial
    FontSize 12
}

title Sơ đồ Use Case Phân hệ Hội đồng chấm KLTN (Defense Council Subsystem)\n(Tham chiếu Bảng 2.4 & Mục 2.1.4 Báo cáo Phân tích Yêu cầu)

actor "Thành viên Hội đồng\n(Chủ tịch, Thư ký, Ủy viên)" as Member
actor "Thư ký / Chủ tịch\nHội đồng" as LeadMember

Member <|-- LeadMember

rectangle "Phân hệ Hội đồng chấm KLTN - UGTM" {
    usecase "UC-COU01: Xem hồ sơ & Báo cáo KLTN\n(Danh sách đề tài, file toàn văn, slide)" as UC01
    usecase "UC-COU02: Nhập điểm thành phần & Nhận xét\n(Thang điểm 0.0 - 10.0 trực tiếp tại buổi bảo vệ)" as UC02
    usecase "Tự động tính điểm trung bình Hội đồng\n(Trung bình cộng các thành viên hợp lệ)" as UC_CalcAvg #EDE7F6
    usecase "UC-COU03: Khóa biên bản điểm Hội đồng\n(Chuyển trạng thái Read-only có xác thực)" as UC03
    usecase "Lập biên bản nhận xét chung của Hội đồng" as UC_Minutes #EDE7F6
}

' Liên kết tác nhân
Member --> UC01
Member --> UC02

LeadMember --> UC03
LeadMember --> UC_Minutes

' Quan hệ Include
UC02 .right.> UC_CalcAvg : <<include>>
UC03 .right.> UC_Minutes : <<include>>

@enduml
