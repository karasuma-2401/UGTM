@startuml UC_Supervisor
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 8
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 60

skinparam actor {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontName Arial
    FontSize 13
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #1976D2
    ArrowColor #1565C0
    FontName Arial
    FontSize 12
}

title Sơ đồ Use Case Phân hệ Giảng viên hướng dẫn (Supervisor Subsystem)\n(Tham chiếu Bảng 2.2 Báo cáo Phân tích Yêu cầu)

actor "Giảng viên hướng dẫn\n(GVHD)" as Supervisor

rectangle "Phân hệ Giảng viên hướng dẫn - UGTM" {
    package "1. Giai đoạn Đề tài (Tuần 0 - 2)" {
        usecase "UC-ADV01: Soạn thảo & Đề xuất đề tài\n(Tên Việt/Anh, số SV, mục tiêu, yêu cầu)" as UC01
        usecase "Chỉnh sửa / Xóa đề tài\n(Khi chưa công bố)" as UC01_Edit #E3F2FD
        usecase "UC-ADV02: Xác nhận nhóm sinh viên\n(Duyệt nhóm đăng ký đề tài)" as UC02
    }

    package "2. Giai đoạn Tiến độ Giữa kỳ (Tuần 3 - 10)" {
        usecase "UC-ADV03: Đánh giá Tiến độ giữa kỳ\n(Cổng kiểm soát 2: Dừng / Tiếp tục KLTN)" as UC03
        usecase "Khai báo lý do dừng KLTN\n(Nếu không đạt tiến độ)" as UC_StopReason #FFEBEE
        usecase "UC-ADV04: Xác nhận Đơn xin ĐTĐT\n(Bước 1 trong luồng liên thông 3 bên)" as UC04
    }

    package "3. Giai đoạn Báo cáo Cuối kỳ (Tuần 11 - 18)" {
        usecase "UC-ADV05: Nhập nhận xét & Chấm điểm GVHD\n(Đánh giá Báo cáo Cuối kỳ)" as UC05
    }

    package "4. Tiện ích Theo dõi" {
        usecase "Theo dõi Dashboard Tiến độ nhóm SV\n(Các mốc hạn chót 7 giai đoạn)" as UC_Track
    }
}

' Liên kết từ GVHD đến các Use Case
Supervisor --> UC01
Supervisor --> UC02
Supervisor --> UC03
Supervisor --> UC04
Supervisor --> UC05
Supervisor --> UC_Track

' Quan hệ mở rộng (Extend)
UC01_Edit .left.> UC01 : <<extend>>
UC_StopReason .left.> UC03 : <<extend>>

@enduml
