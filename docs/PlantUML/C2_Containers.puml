@startuml C2_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title C2 — Container Diagram: Hệ thống Quản lý KLTN (UGTM)

Person(user, "Người dùng hệ thống", "Sinh viên, Giảng viên, Khoa, PĐT, Admin")

Container(spa, "Single Page Application (SPA)", "React 19, TypeScript, Vite, Ant Design", "Giao diện web trực quan, responsive, tra cứu đề tài, nộp tài liệu, theo dõi tiến độ, nhập điểm")

System_Boundary(backend_boundary, "UGTM Backend Monolith (.NET 10 Runtime)") {
    Container(apiHost, "Host API (UGTM.Api)", "ASP.NET Core Web API", "Composition Root: Routing, JWT Auth, CORS, chuyển giao Commands/Queries tới 9 module")
    Container(eventBus, "In-Memory Event Bus", "MediatR / Channels / Outbox", "Vận chuyển Integration Events bất đồng bộ giữa các module nội bộ")
    Container(bgWorker, "Background Worker Service", "IHostedService / Quartz.NET", "Quét bảng Outbox định kỳ, gửi Email nhắc hạn, kiểm tra quá hạn deadline")
}

ContainerDb(database, "Database", "Microsoft SQL Server", "9 Schemas riêng biệt: identity, academic, topics, thesis, progress, evaluation, councils, grading, notifications")
ContainerDb(files, "Tài liệu lưu trữ (File Storage)", "Local Disk / Volume Mount", "Lưu trữ tệp đính kèm bản mềm (PDF, Docx <= 20MB)")

Rel(user, spa, "Tương tác giao diện", "HTTPS")
Rel(spa, apiHost, "Gọi REST API", "HTTPS / JSON (JWT Bearer)")
Rel(apiHost, eventBus, "Publish / Subscribe Events", "Internal In-Memory")
Rel(bgWorker, eventBus, "Dispatch scheduled jobs", "Internal")
Rel(apiHost, database, "Đọc/Ghi dữ liệu theo từng Schema của Module", "EF Core / Dapper / TCP 1433")
Rel(bgWorker, database, "Đọc Outbox / Cập nhật trạng thái", "EF Core")
Rel(apiHost, files, "Lưu & đọc file", "Stream I/O")

@enduml
