@startuml MultiSchema_Database
title UGTM — Một PostgreSQL database / 34 bảng nghiệp vụ / 6 schema
left to right direction
skinparam shadowing false
skinparam linetype ortho
database "identity (6 bảng)\naudit_log\npermission\nrole\nrole_permission\nuser\nuser_role" as identity
database "academic (4 bảng)\nkltn_batch\nscore_component_config\nscore_weight_config\nstage" as academic
database "topics (1 bảng)\ntopic" as topics
database "thesis (10 bảng)\nfinal_report\nfinal_submission\nmidterm_report\nprogress_milestone\nprogress_report\nrename_request\nstudent_group\nstudent_group_member\nsubmission_file\nsyllabus" as thesis
database "councils (12 bảng)\nadvisor_evaluation\ncouncil\ncouncil_assignment\ncouncil_member\ncouncil_minute\ncouncil_score\nevaluation_detail\ngrading_criteria\nreviewer_assignment\nreviewer_evaluation\nscore_summary\nscore_summary_component" as councils
database "notifications (1 bảng)\nnotification" as notifications
councils --> academic : 2 FK
councils --> identity : 7 FK
councils --> thesis : 4 FK
notifications --> identity : 1 FK
thesis --> academic : 1 FK
thesis --> identity : 7 FK
thesis --> topics : 1 FK
topics --> academic : 1 FK
topics --> identity : 1 FK
note "6 DbContext runtime sở hữu từng schema; UGTMDbContext chỉ điều phối migration.\nCó 50 FK tổng cộng; chi tiết từng bảng/cột xem DataModel.md và DatabaseScript.txt.\nAudit ở identity; notification ở notifications; nhóm sinh viên ở thesis.\nSchema shared đã bỏ. Lịch sử EF nằm ở public, ngoài 6 schema nghiệp vụ.\nEntityId của tệp và EvaluationId của chi tiết phiếu chưa có FK tới hồ sơ/phiếu." as N
@enduml
