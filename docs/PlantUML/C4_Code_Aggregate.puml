@startuml C4_Code_Aggregate
skinparam classAttributeIconSize 0
skinparam roundcorner 5
hide circle

title C4 — Code Diagram: Domain Model Aggregate (Thesis Management)

abstract class Entity {
    +Guid Id
    +bool Equals(object obj)
    +int GetHashCode()
}

abstract class AggregateRoot {
    -List<IDomainEvent> _domainEvents
    +IReadOnlyCollection<IDomainEvent> DomainEvents
    #AddDomainEvent(IDomainEvent domainEvent)
    +ClearDomainEvents()
}

class Thesis {
    -Guid _topicId
    -Guid _academicPeriodId
    -Guid _supervisorId
    -List<StudentMember> _members
    -ThesisOutline _outline
    -ThesisStatus _status
    +Thesis(Guid topicId, Guid periodId, Guid supervisorId, Guid creatorStudentId)
    +Result AddMember(Guid studentId, string fullName)
    +Result SubmitOutline(string fileUrl, string fileName, long fileSizeBytes)
    +Result ReviewOutline(bool isApproved, string remarks, Guid reviewerId)
    +Result ChangeStatus(ThesisStatus newStatus)
}

class StudentMember {
    +Guid StudentId
    +string FullName
    +bool IsLeader
    +DateTime JoinedAt
}

class ThesisOutline <<ValueObject>> {
    +string FileUrl
    +string FileName
    +int Version
    +DateTime SubmittedAt
    +string ReviewStatus
    +string Remarks
}

enum ThesisStatus {
    Registered
    OutlinePendingReview
    OutlineNeedRevision
    OutlineApproved
    InProgress
    StoppedAtMidterm
    ReadyForDefense
    Completed
}

interface IDomainEvent {
    +DateTime OccurredOn
}

class ThesisRegisteredDomainEvent implements IDomainEvent {
    +Guid ThesisId
    +Guid TopicId
    +Guid CreatorStudentId
    +DateTime OccurredOn
}

class OutlineSubmittedDomainEvent implements IDomainEvent {
    +Guid ThesisId
    +int Version
    +DateTime OccurredOn
}

interface IThesisRepository {
    +Task<Thesis> GetByIdAsync(Guid id)
    +Task AddAsync(Thesis thesis)
    +Task UpdateAsync(Thesis thesis)
}

Entity <|-- AggregateRoot
AggregateRoot <|-- Thesis
Entity <|-- StudentMember

Thesis "1" *-- "1..3" StudentMember : members
Thesis "1" *-- "0..1" ThesisOutline : current outline
Thesis --> ThesisStatus : status
Thesis ..> ThesisRegisteredDomainEvent : raises
Thesis ..> OutlineSubmittedDomainEvent : raises
IThesisRepository ..> Thesis : persists

note right of Thesis
  <b>Domain Rule:</b>
  - Số lượng thành viên: 1..3 sinh viên
  - Dung lượng file đề cương <= 20MB (.pdf, .doc, .docx)
  - Mọi thay đổi trạng thái đều sinh Domain Event
end note

@enduml
