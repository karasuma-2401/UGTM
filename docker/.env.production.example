# Copy privately to the VM or configure equivalent GitHub production secrets.
# No database or bucket is created by a normal deploy.
API_IMAGE=ghcr.io/karasuma-2401/ugtm-api@sha256:REPLACE_WITH_SCANNED_RELEASE_DIGEST
AI_IMAGE=ghcr.io/karasuma-2401/ugtm-ai@sha256:REPLACE_WITH_SCANNED_RELEASE_DIGEST
GATEWAY_IMAGE=ghcr.io/karasuma-2401/ugtm-gateway@sha256:REPLACE_WITH_SCANNED_RELEASE_DIGEST
API_HOST=ugtm.eastasia.cloudapp.azure.com
ACME_EMAIL=ops@example.test
APP_URL=https://ugtm-three.vercel.app

DATABASE_CONNECTION_STRING=Host=UGTM-POOLER-HOST;Database=neondb;Username=ugtm;Password=replace-me;SSL Mode=Require
AI_POSTGRES_DSN=postgresql://ai:replace-me@AI-POOLER-HOST/neondb?sslmode=require
AI_POSTGRES_DIRECT_DSN=postgresql://ai:replace-me@AI-DIRECT-HOST/neondb?sslmode=require
PLAGIARISM_AI_API_KEY=replace-with-a-long-random-internal-key
PLAGIARISM_AI_DEFAULT_CORPUS=uit-kltn-library-v1
REMOTE_GPU_URL=https://YOUR-EXISTING-WORKER.modal.run
REMOTE_GPU_API_KEY=replace-with-the-existing-gpu-key

MINIO_ROOT_USER=ugtm-admin
MINIO_ROOT_PASSWORD=replace-with-a-long-random-admin-password
S3_ACCESS_KEY=ugtm-backend
S3_SECRET_KEY=replace-with-backend-user-secret
S3_BUCKET_NAME=ugtm-thesis-submissions
AI_S3_ACCESS_KEY=ugtm-ai
AI_S3_SECRET_KEY=replace-with-ai-user-secret
AI_S3_BUCKET_NAME=ugtm-ai
# Tested multi-architecture digests; the MC variant includes the provisioning shell.
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:16b824a0016ffad3dfa8b059755f83800aa42ca68fe86f1782cabd0c5a16d322
MINIO_MC_IMAGE=cgr.dev/chainguard/minio-client@sha256:b0e6a285831396d65c8ceb3246cb0379b36e9954469f173a8daded098acd6fc5

IDENTITY_IP_HASH_KEY=replace-with-the-existing-stable-key-at-least-32-characters
JWT_PRIVATE_KEY_FILE=/home/ubuntu/ugtm/production/releases/RELEASE_SHA/secrets/ugtm-jwt-private.pem
AI_ARTIFACTS_DIR=/home/ubuntu/ugtm/production/ai-artifacts
# Enable only after provisioning and checking the existing classifier + manifest.
AI_CLASSIFIER_ENABLED=false

SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_FROM_ADDRESS=no-reply@example.test
SMTP_FROM_NAME=UGTM
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_SECURITY=StartTls
SMTP_TIMEOUT_SECONDS=30

# Set these to the inspected old volume names during the first cutover.
DATA_PROTECTION_VOLUME=ugtm-production_data_protection_keys
CADDY_DATA_VOLUME=ugtm-production_caddy_data
CADDY_CONFIG_VOLUME=ugtm-production_caddy_config
MINIO_DATA_VOLUME=ugtm-production_minio_data
