# ========================================================
# UGTM LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials
# ========================================================

# Production gateway (used by docker/docker-compose.prod.yml)
# API_HOST must be a DNS hostname pointing to the VPS public IP, without scheme or path.
API_HOST=api.example.edu.vn
ACME_EMAIL=ops@example.edu.vn
# Public Vercel origin used for CORS and links in activation/recovery emails.
APP_URL=https://app.example.edu.vn

# Neon Serverless PostgreSQL Connection String
DATABASE_CONNECTION_STRING=Host=ep-bitter-fog-az92i9bp-pooler.c-3.ap-southeast-1.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=your_neon_password;SSL Mode=Require;Trust Server Certificate=true;

# Local RSA signing key generated by scripts/GenerateDevelopmentJwtKey.ps1
JWT_PRIVATE_KEY_FILE=./secrets/ugtm-jwt-private.pem

# HMAC secret used to pseudonymize client IP addresses in authentication sessions.
# Use a random value with at least 32 characters and keep it stable across replicas.
IDENTITY_IP_HASH_KEY=<replace-with-a-random-secret-of-at-least-32-characters>

# Real SMTP email delivery (example: Google Workspace/Gmail on port 587)
# Use an App Password or provider-issued SMTP credential; never use your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_FROM_ADDRESS=your-sender@ugtm.edu.vn
SMTP_FROM_NAME=UGTM
SMTP_USERNAME=your-sender@ugtm.edu.vn
SMTP_PASSWORD=<replace-with-smtp-app-password>
SMTP_TIMEOUT_SECONDS=30

# Redis Configuration
REDIS_PASSWORD=ugtm_redis_pass_123

# RabbitMQ Message Broker
RABBITMQ_USER=ugtm_user
RABBITMQ_PASSWORD=ugtm_rabbit_pass_123

# MinIO S3 Object Storage
MINIO_ROOT_USER=ugtm_admin
MINIO_ROOT_PASSWORD=ugtm_secret_pass_123

# One-time Initial Admin Bootstrap (Optional: used on startup to bootstrap the first Admin if no Admin exists)
# BOOTSTRAP_ADMIN_EMAIL=admin@ugtm.edu.vn
# BOOTSTRAP_ADMIN_PASSWORD=<set-a-unique-secret-and-never-commit-it>
# BOOTSTRAP_ADMIN_FULLNAME=System Administrator

